---
interface StudyItem {
  title: string;
  institution: string;
  description: string;
  tags?: string[];
}

interface Props {
  items: StudyItem[];
  title?: string;
}

const { items, title } = Astro.props as Props;
---

<section class="w-full py-8">
  <div class="mx-auto max-w-6xl px-4">
    {title && (
      <h2 class="text-3xl md:text-4xl font-semibold text-center mb-6 text-foreground">{title}</h2>
    )}

    <div class="mt-8 mb-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto" data-reveal>
      {items.map((study) => (
        <article class="card-surface p-6" data-reveal-child>
          <h4 class="text-xl font-semibold text-foreground">{study.title}</h4>
          <div class="mt-1 text-sm text-[color:var(--color-text-secondary)]">{study.institution}</div>
          <p class="mt-3 text-justify hyphens-auto text-[color:var(--color-text-secondary)]" set:html={study.description} />
          {study.tags && study.tags.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2.5">
              {study.tags.map((tag) => (
                <span class="pill-tech">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>


