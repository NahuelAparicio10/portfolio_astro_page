---
import GlowLineSeparator from '@/components/ui/separator/GlowLineSeparator.astro';
import { loadLogosFrom } from '../../data/logos';
import { getSkills } from '../../data/skills';
import { useTranslations } from '../../i18n';
import { getLocaleFromPath } from '../../lib/href';
import Carousel from '../ui/carousel/Carousel.astro';

interface Props {
  title?: string;
}

const { title } = Astro.props as Props;

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const skills = getSkills(locale);

const carousels = [
  { heading: t.skills.programming, group: 'programming' },
  { heading: t.skills.engines, group: 'engines' },
  { heading: t.skills.ides, group: 'ides' },
  { heading: t.skills.sourceControl, group: 'source_control' },
  { heading: t.skills.design, group: 'design' },
] as const;

const HEADING = 'text-3xl md:text-4xl font-semibold text-center mb-6 text-foreground';
/** Larger pill used for soft skills and languages. */
const PILL_LG = 'pill-tech pill-lg';
---

<section class="w-full">
  <div class="mx-auto max-w-6xl px-4">
    <h3 class={HEADING}>{t.skills.expertiseTitle}</h3>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6" data-reveal>
      {skills.map((skill) => (
        <article class="card-surface p-6" data-reveal-child>
          <div class="flex items-start gap-4">
            <span
              class="shrink-0 text-[var(--accent)] [&>svg]:w-7 [&>svg]:h-7"
              aria-hidden="true"
              set:html={skill.icon}
            />
            <div class="min-w-0">
              <h4 class="text-xl font-semibold text-foreground m-0">{skill.title}</h4>
              <p class="mt-1 mb-0 text-sm text-[color:var(--color-text-muted)]">{skill.description}</p>
              <ul class="skill-points mt-3">
                {skill.points.map((point) => <li set:html={point} />)}
              </ul>
              <div class="mt-4 flex flex-wrap gap-2">
                {skill.tags.map((tag) => (
                  <span class="pill-tech">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    {carousels.map((item) => (
      <>
        <GlowLineSeparator class="mb-8 mt-8" />
        <h3 class={HEADING}>{item.heading}</h3>
        <Carousel tools={loadLogosFrom(item.group)} />
      </>
    ))}

    <GlowLineSeparator class="mb-8 mt-8" />

    <h3 class={HEADING}>{t.skills.softTitle}</h3>
    <div class="mt-7 mb-15 flex flex-wrap justify-center gap-3" data-reveal>
      {t.skills.soft.map((skill) => (
        <span class={PILL_LG} data-reveal-child>{skill}</span>
      ))}
    </div>

    <GlowLineSeparator class="mb-8 mt-8" />

    <h3 class={HEADING}>{t.skills.languagesTitle}</h3>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      {t.skills.languages.map((language) => (
        <span class={`${PILL_LG} pill-lang`}>{language}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .skill-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .skill-points li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  /* Accent chevron instead of a bullet: reads as a list without the dot noise. */
  .skill-points li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.5em;
    width: 0.4rem;
    height: 0.4rem;
    border-right: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(-45deg);
  }
</style>
