---
import HeaderLink from './HeaderLink.astro';
import {
  asset,
  getLocaleFromPath,
  href,
  isSamePath,
  localizedUrl,
} from '../../lib/href';
import { useTranslations } from '../../i18n';

const currentPath = Astro.url.pathname;
const locale = getLocaleFromPath(currentPath);
const isES = locale === 'es';
const t = useTranslations(locale);

/**
 * URL of the current page in the other language, resolved on the server so the
 * browser never has to do path arithmetic.
 */
const altUrl = localizedUrl(currentPath, isES ? 'en' : 'es');

const path = (slug: string) => href(slug, locale);

const activeClass = (target: string) =>
  `px-3 py-3 font-bold no-underline rounded-md transition-colors ${
    isSamePath(currentPath, target)
      ? 'text-[var(--accent)] bg-[var(--accent)]/10'
      : 'text-[color:var(--color-text-secondary)] hover:text-[var(--accent)] hover:bg-[var(--accent)]/10'
  }`;

const nav = [
  { slug: '/', label: t.nav.home },
  { slug: '/about', label: t.nav.about },
  { slug: '/Skills', label: t.nav.skills },
  { slug: '/blog', label: t.nav.games },
  { slug: '/portfolio', label: t.nav.projects },
  { slug: '/#contact', label: t.nav.contact },
];
---

<!-- Sticky and above the hero: the home page pulls the hero up with a negative
     margin to sit the video behind the header, which was covering the nav. -->
<header class="sticky top-0 z-50 text-foreground border-b border-[color:var(--color-border-light)] sw-header mb-0 bg-[color:var(--background)]/75 backdrop-blur-md supports-[backdrop-filter]:bg-[color:var(--background)]/60">
  <nav class="mx-auto max-w-6xl px-4 py-2 flex items-center justify-between">
    <!-- Logo + enlaces de escritorio -->
    <div class="flex items-center gap-3">
      <a class="no-underline hover:opacity-90 flex items-center gap-2" href={path('/')} aria-label="Home">
        <img src={asset('/NaguCode_Logo.jpg')} alt="" aria-hidden="true" width="45" height="45" />
      </a>

      <div class="internal-links hidden md:flex items-center gap-2 ml-1">
        {nav.map((item) => (
          <HeaderLink href={path(item.slug)} class={activeClass(path(item.slug))}>{item.label}</HeaderLink>
        ))}
      </div>
    </div>

    <!-- Idioma + hamburguesa -->
    <div class="flex items-center gap-2">
      <!-- Segmented EN/ES control. The inactive half is a real link, so it
           works without JavaScript and can be opened in a new tab. -->
      <div class="lang-switch" role="group" aria-label="Language">
        <span class="lang-pill" aria-hidden="true"></span>
        {(['en', 'es'] as const).map((code) => (
          code === locale ? (
            <span class="lang-opt is-active" aria-current="true">{code.toUpperCase()}</span>
          ) : (
            <a
              class="lang-opt"
              href={altUrl}
              hreflang={code}
              aria-label={t.nav.switchLanguage}
            >{code.toUpperCase()}</a>
          )
        ))}
      </div>

      <button
        data-menu-btn
        class="md:hidden inline-flex items-center justify-center rounded-md p-2 border border-[color:var(--color-text-muted)]/30"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={t.nav.openMenu}
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M3 6h18v2H3zM3 11h18v2H3zM3 16h18v2H3z"/>
        </svg>
      </button>
    </div>
  </nav>

</header>

<!-- Menú móvil a pantalla completa -->
<div id="mobile-menu" class="mobile-menu md:hidden" hidden>
  <nav class="mobile-menu-inner">
    {nav.map((item, index) => (
      <a
        href={path(item.slug)}
        class:list={['mobile-link', isSamePath(currentPath, path(item.slug)) && 'is-active']}
        style={`--i:${index}`}
      >{item.label}</a>
    ))}
  </nav>
</div>

<style>
  /* Full-screen overlay rather than a dropdown: on a phone the nav deserves the
     whole viewport, and it removes the risk of the panel overflowing. */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: color-mix(in oklab, var(--background) 92%, transparent);
    backdrop-filter: blur(14px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms var(--motion-ease, ease);
  }

  .mobile-menu[data-open] {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.4rem;
    height: 100%;
    padding: 5rem 1.5rem 2rem;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 0 1rem;
    border-radius: 14px;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 7vw, 2.2rem);
    font-weight: 700;
    color: var(--foreground);
    text-decoration: none;
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 340ms var(--motion-ease, ease),
      transform 340ms var(--motion-ease, ease),
      background-color 180ms ease,
      color 180ms ease;
  }

  /* Staggered entrance, one step per item. */
  .mobile-menu[data-open] .mobile-link {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 45ms + 60ms);
  }

  .mobile-link:active {
    background: rgba(var(--accent-rgb), 0.12);
  }

  .mobile-link.is-active {
    color: var(--accent);
    background: rgba(var(--accent-rgb), 0.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-link {
      transition: none;
    }

    .mobile-menu[data-open] .mobile-link {
      transition-delay: 0ms;
    }
  }

  /* Segmented control: a sliding pill marks the active language instead of the
     old flag toggle. Grid keeps both halves the same width so the pill can be
     positioned with a plain translate. */
  .lang-switch {
    position: relative;
    display: inline-grid;
    grid-template-columns: repeat(2, 2.6rem);
    align-items: center;
    padding: 0.2rem;
    border-radius: 999px;
    border: 1px solid var(--color-border-light);
    background: var(--surface-100);
  }

  .lang-pill {
    position: absolute;
    top: 0.2rem;
    bottom: 0.2rem;
    left: 0.2rem;
    width: 2.6rem;
    border-radius: 999px;
    background: rgba(var(--accent-rgb), 0.18);
    border: 1px solid rgba(var(--accent-rgb), 0.45);
    transition: transform var(--motion-base, 400ms) var(--motion-ease, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .lang-switch:has(.lang-opt:last-child.is-active) .lang-pill {
    transform: translateX(2.6rem);
  }

  .lang-opt {
    position: relative;
    z-index: 1;
    padding: 0.3rem 0;
    text-align: center;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    border-radius: 999px;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--motion-fast, 180ms) ease, transform var(--motion-fast, 180ms) ease;
  }

  .lang-opt.is-active {
    color: var(--accent);
  }

  a.lang-opt:hover {
    color: var(--foreground);
    transform: translateY(-1px);
  }

  a.lang-opt:active {
    transform: translateY(0) scale(0.94);
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-pill,
    .lang-opt {
      transition: none;
    }

    a.lang-opt:hover,
    a.lang-opt:active {
      transform: none;
    }
  }
</style>

<script>
  /**
   * Re-bound on every navigation.
   *
   * With <ClientRouter /> the document is swapped without re-running this
   * script, so anything captured once ends up pointing at detached nodes from
   * the first page that loaded. The menu button worked on a cold load and did
   * nothing afterwards.
   */
  function initMenu() {
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
    const panel = document.getElementById('mobile-menu');
    if (!btn || !panel) return;

    let closeTimer = 0;

    const isOpen = () => panel.hasAttribute('data-open');

    function setMenu(open: boolean) {
      window.clearTimeout(closeTimer);
      if (open) {
        // `hidden` has to come off first, or the transition has nothing to
        // animate from.
        panel.hidden = false;
        requestAnimationFrame(() => panel.setAttribute('data-open', ''));
      } else {
        panel.removeAttribute('data-open');
        closeTimer = window.setTimeout(() => { panel.hidden = true; }, 260);
      }
      btn.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('overflow-hidden', open);
    }

    btn.addEventListener('click', () => setMenu(!isOpen()));

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenu(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) setMenu(false);
    });

    // Leaving the page with the menu open would otherwise keep the scroll lock.
    document.addEventListener('astro:before-swap', () => {
      document.documentElement.classList.remove('overflow-hidden');
    }, { once: true });
  }

  initMenu();
  document.addEventListener('astro:page-load', initMenu);
</script>
