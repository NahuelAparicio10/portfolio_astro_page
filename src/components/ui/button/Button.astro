---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className,
  ...rest
} = Astro.props as Props;

const Tag = href ? 'a' : 'button';

// btn-juicy carries the lift, sheen and press response shared by every button.
const base = 'btn-juicy no-underline';
const sizes: Record<string, string> = {
  sm: 'px-3 py-2 text-sm',
  md: 'px-4 py-2.5 text-base',
  lg: 'px-5 py-3 text-lg',
};
const variants: Record<string, string> = {
  primary: 'is-solid',
  secondary: '',
  ghost: 'border-transparent bg-transparent text-[color:var(--color-text-secondary)]',
  outline: 'border-[var(--border)] bg-transparent text-foreground',
};

const classes = [base, sizes[size], variants[variant], className].filter(Boolean).join(' ');

// Detectar enlaces externos
const isExternal = href?.startsWith("http://") || href?.startsWith("https://");
---

<Tag
  class={classes}
  href={href}
  type={!href ? type : undefined}
  aria-disabled={disabled ? 'true' : undefined}
  {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
  {...rest}
>
  <slot />
</Tag>
