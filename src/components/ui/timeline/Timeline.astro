---
interface Item {
  title: string;
  company: string;
  /** Date range, shown as its own metadata line rather than buried in the copy. */
  period?: string;
  region: string;
  description: string;
  /** Scannable bullets rendered under the summary. */
  highlights?: string[];
  technologies?: string[];
}

interface Props { items: Item[], icons?: { job: string; company: string; location: string }, centered?: boolean }
// fallback icons from assets if not provided via props
// @ts-ignore - vite raw import yields string
import jobIconRaw from '../../../assets/icons/job-title-icon.svg?raw';
// @ts-ignore
import companyIconRaw from '../../../assets/icons/company-icon.svg?raw';
// @ts-ignore
import locationIconRaw from '../../../assets/icons/location-icon.svg?raw';

function normalizeIcon(raw: string): string {
  let s = raw
    .replace(/<\?xml[\s\S]*?\?>/g, '')
    .replace(/<!--([\s\S]*?)-->/g, '')
    .replace(/width=\"[^\"]+\"/g, 'width="16"')
    .replace(/height=\"[^\"]+\"/g, 'height="16"')
    .replace(/stroke=\"#000000\"/g, 'stroke="currentColor"')
    .replace(/fill=\"#000000\"/g, 'fill="none"')
    .replace(/fill=\"#ffffff\"/gi, 'fill="none"');
  // Ensure root svg has fill="none" and stroke="currentColor"
  s = s.replace(/<svg([^>]*)>/, (m, attrs) => {
    let a = attrs;
    if (!/fill=/.test(a)) a += ' fill="none"';
    if (!/stroke=/.test(a)) a += ' stroke="currentColor"';
    return `<svg${a}>`;
  });
  return s;
}

const props = Astro.props as Props;
const calendarIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>`;

const jobIcon = (props.icons?.job ?? normalizeIcon(jobIconRaw));
const companyIcon = (props.icons?.company ?? normalizeIcon(companyIconRaw));
const locationIcon = (props.icons?.location ?? normalizeIcon(locationIconRaw));
const { items, centered = true } = props;
---

{centered ? (
  <div class="relative mx-auto max-w-5xl px-0 md:px-0">
    <!-- Center vertical line -->
    <div class="pointer-events-none absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-[var(--border)]"></div>

    <div class="space-y-12" data-reveal>
      {items.map((item, index) => {
        const isLeft = index % 2 === 0;
        return (
          <div data-reveal-child class:list={[
            'relative flex items-stretch',
            isLeft ? 'justify-start' : 'justify-end',
          ]}>
            <!-- Dot on the center line -->
            <div class="absolute left-1/2 -translate-x-1/2 top-4 size-3 rounded-full bg-[var(--accent)] ring-4 ring-[color:var(--background)]"></div>

            <div class:list={[
              'w-full md:w-1/2',
              isLeft ? 'pr-6 md:pr-12' : 'pl-6 md:pl-12',
            ]}>
              <div class="card-surface p-6">
                <div class="mb-2 space-y-1">
                  <h3 class="text-lg leading-snug font-semibold text-foreground m-0 flex items-center gap-2">
                    <span class="inline-flex" aria-hidden="true" set:html={jobIcon} />
                    {item.title}
                  </h3>
                  <p class="text-sm font-medium text-[color:var(--color-text-muted)] m-0 flex items-center gap-2">
                    <span class="inline-flex" aria-hidden="true" set:html={companyIcon} />
                    {item.company}
                  </p>
                  <p class="text-sm text-[color:var(--color-text-muted)] m-0 flex items-center gap-2">
                    <span class="inline-flex" aria-hidden="true" set:html={locationIcon} />
                    {item.region}
                  </p>
                  {item.period && (
                    <p class="text-sm text-[color:var(--color-text-muted)] m-0 flex items-center gap-2">
                      <span class="inline-flex" aria-hidden="true" set:html={calendarIcon} />
                      {item.period}
                    </p>
                  )}
                </div>
                <p class="text-[color:var(--color-text-secondary)] text-justify hyphens-auto m-0">{item.description}</p>
                {item.highlights && item.highlights.length > 0 && (
                  <ul class="timeline-points mt-3">
                    {item.highlights.map((point) => <li set:html={point} />)}
                  </ul>
                )}
                {item.technologies && item.technologies.length > 0 && (
                  <div class="mt-5 flex flex-wrap gap-2.5">
                    {item.technologies.map((tech) => (
                      <span class="pill-tech">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
) : (
    <div class="relative mx-auto max-w-5xl px-0 md:px-0">
    <!-- Left vertical line -->
    <div class="pointer-events-none absolute inset-y-0 left-0 md:left-5 w-px bg-[var(--border)]"></div>
    <div class="space-y-8 md:space-y-12" data-reveal>
      {items.map((item) => (
        <div class="relative pl-5 md:pl-16" data-reveal-child>
          <div class="absolute left-0 md:left-5 top-3 md:top-4 size-2 md:size-3 rounded-full bg-[var(--accent)] ring-2 md:ring-4 ring-[color:var(--background)]"></div>
          <div class="card-surface p-4 md:p-6 w-full min-w-0">
            <div class="mb-2 space-y-1">
              <h3 class="text-lg leading-snug font-semibold text-foreground m-0 flex items-center gap-2">
                <span class="inline-flex" aria-hidden="true" set:html={jobIcon} />
                {item.title}
              </h3>
              <p class="text-sm font-medium text-[color:var(--color-text-muted)] m-0 flex items-center gap-2">
                <span class="inline-flex" aria-hidden="true" set:html={companyIcon} />
                {item.company}
              </p>
              <p class="text-sm text-[color:var(--color-text-muted)] m-0 flex items-center gap-2">
                <span class="inline-flex" aria-hidden="true" set:html={locationIcon} />
                {item.region}
              </p>
              {item.period && (
                <p class="text-sm text-[color:var(--color-text-muted)] m-0 flex items-center gap-2">
                  <span class="inline-flex" aria-hidden="true" set:html={calendarIcon} />
                  {item.period}
                </p>
              )}
            </div>
            <p class="text-[color:var(--color-text-secondary)] text-justify hyphens-auto m-0">{item.description}</p>
            {item.highlights && item.highlights.length > 0 && (
              <ul class="timeline-points mt-3">
                {item.highlights.map((point) => <li set:html={point} />)}
              </ul>
            )}
            {item.technologies && item.technologies.length > 0 && (
              <div class="mt-5 flex flex-wrap gap-2.5">
                {item.technologies.map((tech) => (
                  <span class="pill-tech">
                    {tech}
                  </span>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
)}

<style>
  .timeline-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .timeline-points li {
    position: relative;
    padding-left: 1.35rem;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-align: justify;
    hyphens: auto;
  }

  /* Accent chevron instead of a bullet: reads as a list without the dot noise. */
  .timeline-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.42rem;
    height: 0.42rem;
    border-right: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(-45deg);
  }
</style>
