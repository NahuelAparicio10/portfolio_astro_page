---
import { DEFAULT_LOCALE, href, type Locale } from '../../../lib/href';

interface Props {
  currentPage: number;
  totalPages: number;
  /** Locale-agnostic path, e.g. '/blog/page'. The base and locale are added here. */
  basePath?: string;
  locale?: Locale;
}

const { currentPage, totalPages, basePath = '/blog/page', locale = DEFAULT_LOCALE } = Astro.props as Props;

const prevHref = currentPage > 1
  ? (currentPage === 2 ? href('/blog/', locale) : href(`${basePath}/${currentPage - 1}/`, locale))
  : null;
const nextHref = currentPage < totalPages ? href(`${basePath}/${currentPage + 1}/`, locale) : null;

const labels = {
  en: { prev: 'Previous', next: 'Next', page: 'Page', of: 'of' },
  es: { prev: 'Anterior', next: 'Siguiente', page: 'Página', of: 'de' },
}[locale];
---

{totalPages > 1 && (
  <nav class="mt-6 flex items-center justify-center gap-3" aria-label="Pagination">
    {prevHref ? (
      <a href={prevHref} class="sw-btn">{labels.prev}</a>
    ) : (
      <span class="sw-btn" style="opacity:.5; pointer-events:none;">{labels.prev}</span>
    )}
    <span class="text-sm text-[color:var(--color-text-muted)]">
      {labels.page} {currentPage} {labels.of} {totalPages}
    </span>
    {nextHref ? (
      <a href={nextHref} class="sw-btn">{labels.next}</a>
    ) : (
      <span class="sw-btn" style="opacity:.5; pointer-events:none;">{labels.next}</span>
    )}
  </nav>
)}


