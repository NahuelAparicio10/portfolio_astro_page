---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/sections/Footer.astro';
import Header from '../components/sections/Header.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { asset } from '../lib/href';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nahuel Aparicio',
  jobTitle: 'Game Programmer',
  url: new URL(asset('/'), Astro.site).toString(),
  image: new URL(asset('/NaguCode_Logo.jpg'), Astro.site).toString(),
  sameAs: [
    'https://x.com/naguuu10',
    'https://www.linkedin.com/in/nahuel-aparicio-del-blanco-193234327/',
    'https://github.com/NahuelAparicio10',
    'https://nahuelcode.itch.io/',
  ],
};
---

<!doctype html>
<html lang="en" data-theme="dark" class="dark">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body class="overflow-x-hidden">
    <Header />
    <main class="w-full max-w-none p-0 m-0 use-utility-layout">
      <div class="full-bleed -mt-[var(--header-h)]">
        <HomeHero locale="en" />
      </div>
    </main>
    <Footer />
  </body>
</html>
