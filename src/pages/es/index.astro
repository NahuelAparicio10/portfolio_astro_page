---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/sections/Footer.astro';
import Header from '../../components/sections/Header.astro';
import HomeHero from '../../components/sections/HomeHero.astro';
import { useTranslations } from '../../i18n';
import { asset } from '../../lib/href';

const t = useTranslations('es');

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nahuel Aparicio',
  jobTitle: 'Programador de Videojuegos',
  url: new URL(asset('/es/'), Astro.site).toString(),
  image: new URL(asset('/NaguCode_Logo.jpg'), Astro.site).toString(),
  sameAs: [
    'https://x.com/naguuu10',
    'https://www.linkedin.com/in/nahuel-aparicio-del-blanco-193234327/',
    'https://github.com/NahuelAparicio10',
    'https://nahuelcode.itch.io/',
  ],
};
---

<!doctype html>
<html lang="es" data-theme="dark" class="dark">
  <head>
    <BaseHead title="Nahuel Aparicio – Portfolio" description={t.home.tagline} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body class="overflow-x-hidden">
    <Header />
    <main class="w-full max-w-none p-0 m-0 use-utility-layout">
      <div class="hero-bleed">
        <HomeHero locale="es" />
      </div>
    </main>
    <Footer />
  </body>
</html>
